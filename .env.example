# Video Match System - Environment Variables
# Copy this file to .env and update with your values

# ====================
# Application
# ====================
APP_ENV=development
APP_NAME=video-match-system
APP_VERSION=1.0.0

# ====================
# Backend (Spring Boot)
# ====================
BACKEND_PORT=8080
BACKEND_HOST=0.0.0.0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=videomatch
DB_USER=videomatch
DB_PASSWORD=changeme123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRATION_HOURS=24

# ====================
# ML Service (Python/FastAPI)
# ====================
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000

# GPU Configuration
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_LIMIT_MB=9000

# Model Paths
MODEL_PATH=/data/videomatch/models
YOLO_MODEL_PATH=/data/videomatch/models/yolo/yolov8-display.onnx
CLIP_MODEL_PATH=/data/videomatch/models/clip/clip-vit-l-14.onnx
DINO_MODEL_PATH=/data/videomatch/models/dinov2/dinov2-base.onnx
ESRGAN_MODEL_PATH=/data/videomatch/models/esrgan/real-esrgan-x4.onnx
OCR_MODEL_PATH=/data/videomatch/models/ocr

# ONNX Runtime
ONNX_INTER_OP_THREADS=4
ONNX_INTRA_OP_THREADS=8

# Inference Configuration
MAX_BATCH_SIZE=32
MIN_BATCH_SIZE=4
INFERENCE_TIMEOUT_SECONDS=30

# ====================
# Frontend (Next.js)
# ====================
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_APP_NAME=Video Match System

# ====================
# Storage
# ====================
STORAGE_PATH=/data/videomatch
UPLOAD_PATH=/data/videomatch/uploads
VIDEO_PATH=/data/videomatch/videos
IMAGE_PATH=/data/videomatch/images
CACHE_PATH=/data/videomatch/cache
LOG_PATH=/data/videomatch/logs

# Storage Limits
MAX_UPLOAD_SIZE_MB=100
MAX_VIDEO_SIZE_MB=500

# ====================
# Cache Configuration
# ====================
CACHE_ENABLED=true
MEMORY_CACHE_SIZE=10000
DISK_CACHE_SIZE_GB=20
CACHE_TTL_HOURS=24

# ====================
# Vector Database (FAISS)
# ====================
FAISS_INDEX_PATH=/data/videomatch/vector-index
FAISS_INDEX_TYPE=HNSW
FAISS_DIMENSION=768
FAISS_M=16
FAISS_EF_CONSTRUCTION=200
FAISS_EF_SEARCH=100

# ====================
# Processing Queue
# ====================
MAX_CONCURRENT_PROCESSING=4
QUEUE_SIZE_LIMIT=100
HIGH_PRIORITY_WEIGHT=1.0
NORMAL_PRIORITY_WEIGHT=0.5
LOW_PRIORITY_WEIGHT=0.2

# ====================
# Resource Monitoring
# ====================
CPU_THRESHOLD=0.80
RAM_THRESHOLD=0.90
GPU_MEMORY_THRESHOLD=0.85
MONITORING_INTERVAL_SECONDS=5

# ====================
# Logging
# ====================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_RETENTION_DAYS=30

# ====================
# API Configuration
# ====================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ====================
# Feature Flags
# ====================
ENABLE_REAL_ESRGAN=true
ENABLE_OCR_VERIFICATION=true
ENABLE_SIFT_VERIFICATION=true
ENABLE_COLOR_HISTOGRAM_VERIFICATION=true
ENABLE_USER_FEEDBACK=true

# ====================
# Performance
# ====================
# Expected performance targets
TARGET_PROCESSING_TIME_MS=1500
TARGET_THROUGHPUT_PER_HOUR=1000
TARGET_ACCURACY_PERCENT=90

# ====================
# Development
# ====================
DEBUG=false
HOT_RELOAD=true
MOCK_ML_SERVICE=false

# ====================
# Production (Override these in production .env)
# ====================
# BACKEND_HOST=0.0.0.0
# ML_SERVICE_HOST=0.0.0.0
# DB_PASSWORD=<strong-password>
# REDIS_PASSWORD=<strong-password>
# JWT_SECRET=<strong-secret-key>
# LOG_LEVEL=WARN
# DEBUG=false
